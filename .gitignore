# Ignore everything in the data directory
data/*
.cursor/*

# But, do not ignore these specific folders
!data/v1.0_raw_data/Morel/
!data/v1.0_raw_data/Kraft Prusa/
!data/v1.0_raw_data/Arroyo/
!data/v1.0_raw_data/Burrton/
!data/v1.0_raw_data/Cooper/

# Ignore everything in images and vscode directories
images/
.vscode/
code/txt_filtres/

# Ignore log files
*.log

# Ignore everything in the zip_files directory
zip_files/*

# But, do not ignore these specific zip files
!zip_files/Morel.zip
!zip_files/Kraft-Prusa.zip
!zip_files/Arroyo.zip
!zip_files/Burrton.zip
!zip_files/Cooper.zip

# Neural Network Model Directories
# Ignore all model subdirectories except final_train and results
code/src/neural_network/model/*
!code/src/neural_network/model/final_train/
code/src/neural_network/files/
code/src/neural_network/model/best_model_regression/
code/src/neural_network/model/cross_validation/
code/src/neural_network/model/optuna_trials/

# Keep results folder (for CSV logs and predictions)
!code/src/neural_network/results/

# Debug folder - ignore everything
debug/
